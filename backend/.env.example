# Database
# Local PostgreSQL (run: docker compose up -d)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faradhaven?sslmode=disable

# Supabase (get credentials from Supabase Dashboard > Settings > Database)
# Transaction pooler (port 6543) - recommended for serverless/many connections
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432) - use for migrations
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# When "true": run migrations + column mismatch report and exit (do not start server).
# When "false" or unset: skip migrations, start server. Run migrations via `go run ./cmd/generate` or a separate job.
GENERATE_MODELS=false

PORT=8080
ACCEPTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth (password checked at login; token stored on user, sent as Bearer on each request)
# Optional: create first user on startup if table is empty
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=your-secure-password
AUTH_NAME=User


# -----------------------------------------------------------------------------
# AWS S3 (same credentials/region for both buckets via default SDK chain)
# -----------------------------------------------------------------------------
CHARACTER_IMAGES_BUCKET=
BULLETIN_BUCKET=

# -----------------------------------------------------------------------------
# AI / LLM (Google Gemini)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
