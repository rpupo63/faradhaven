#!/bin/bash
set -e

HEALTH_URL="https://api.faradhaven.xyz/healthcheck"
MAX_RETRIES=10
RETRY_DELAY=2

echo "Building production binary..."
go build -ldflags="-s -w" -o server .

echo "Uploading to racknerd-backend..."
scp server racknerd-backend:~

echo "Installing binary and restarting service..."
ssh racknerd-backend '
    sudo systemctl stop faradhaven
    sudo mv ~/server /opt/faradhaven/server
    sudo chown faradhaven:faradhaven /opt/faradhaven/server
    sudo chmod +x /opt/faradhaven/server
    sudo systemctl daemon-reload
    sudo systemctl restart faradhaven
'

echo "Checking deployment health at $HEALTH_URL..."
for i in $(seq 1 $MAX_RETRIES); do
    if curl -sf "$HEALTH_URL" > /dev/null 2>&1; then
        echo "Health check passed!"
        curl -s "$HEALTH_URL" | jq .
        echo "Deploy complete!"
        exit 0
    fi
    echo "Attempt $i/$MAX_RETRIES - waiting ${RETRY_DELAY}s..."
    sleep $RETRY_DELAY
done

echo "Health check failed after $MAX_RETRIES attempts!"
echo "Checking service status..."
ssh racknerd-backend 'sudo systemctl status faradhaven'
exit 1
